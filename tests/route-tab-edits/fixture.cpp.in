// Focused native fixture. Production blocks substituted verbatim by the runner.
#include <QApplication>
#include <QPlainTextEdit>
#include <QTabBar>
#include <QTimer>
#include <QSet>
#include <QJsonArray>
#include <QJsonObject>
#include <functional>
#include <iostream>
#include <memory>
#include <stdexcept>
#include "ui_RouteItem.h"

inline void MW_show_log(const char *) {}
namespace Configs {
@enums@
struct JsonStore {};
struct ProxyEntity { QString DisplayName() const { return "fixture-proxy"; } };
struct ProfileManager { std::shared_ptr<ProxyEntity> GetProfile(int) { return {}; } };
inline ProfileManager manager;
inline ProfileManager *profileManager = &manager;
inline QString get_rule_set_name(QString name) { return name; }
class RouteRule {
public:
@rule_fields@
    RouteRule();
    RouteRule(const RouteRule&);
    QJsonObject get_rule_json(bool, bool, const QString&);
    static QJsonObject getOutboundObject(std::shared_ptr<ProxyEntity>) { return {}; }
    void set_field_value(const QString&, const QStringList&);
    bool isEmpty();
};
class RoutingChain : public JsonStore {
public:
    int id = -1;
    QString chain_name = "fixture-route", update_url;
    bool skip_update = false;
    QList<std::shared_ptr<RouteRule>> Rules;
    int defaultOutboundID = proxyID;
    RoutingChain() = default;
    RoutingChain(const RoutingChain&);
    QString GetSimpleRules(simpleAction);
    QString UpdateSimpleRules(const QString&, simpleAction);
    QString getNotes() const { return "original notes"; }
    bool saveNotes(const QString& value) { savedNotes = value; return true; }
    QString savedNotes;
private:
    static bool add_simple_rule(const QString&, const std::shared_ptr<RouteRule>&, ruleType);
    static bool add_simple_address_rule(const QString&, const std::shared_ptr<RouteRule>&);
    static bool add_simple_process_rule(const QString&, const std::shared_ptr<RouteRule>&, ruleType);
};
#define rule_lambda RouteRule::getOutboundObject
@MODEL_FUNCTIONS@
@chain_copy@
#undef rule_lambda
}

#include <3rdparty/qv2ray/v2/ui/QvAutoCompleteTextEdit.hpp>
inline QStringList warnings;
inline void MessageBoxWarning(const QString&, const QString& text) { warnings << text; }
inline void MessageBoxInfo(const QString&, const QString& text) { warnings << text; }
template<class F> void runOnUiThread(F function) { QTimer::singleShot(0, qApp, function); }
inline QList<QString> default_outbound_choose = {"proxy", "direct", "block"};

class RouteItem : public QDialog {
    Q_OBJECT
public:
    Ui::RouteItem *ui;
    std::shared_ptr<Configs::RoutingChain> chain, saved;
    int currentIndex = -1;
@box_members@
    explicit RouteItem(const std::shared_ptr<Configs::RoutingChain>& routeChain)
        : ui(new Ui::RouteItem) {
        ui->setupUi(this);
@chain_initialization@
        ui->route_name->setText(chain->chain_name);
        ui->url->setText(chain->update_url);
        ui->skip_update->setChecked(chain->skip_update);
        ui->def_out->setCurrentIndex(default_outbound_choose.indexOf(
            Configs::outboundIDToString(chain->defaultOutboundID)));
        ui->rule_attr->addItems({"domain", "ip_cidr", "process_name", "process_path", "port"});
        QStringList ruleItems;
@boxes_setup@
@tab_connection@
@edit_connections@
        connect(this, &RouteItem::settingsChanged, this, [this](auto value) { saved = value; });
    }
    ~RouteItem() override { delete ui; }
    void loadSimpleBoxes();
    QString commitSimpleBoxes();
    void accept() override;
    void updateRouteItemsView();
    // Advanced display formatting is excluded; production input signal handlers
    // still edit real RoutingChain/RouteRule data via set_field_value.
    void updateRuleSection() {}
    void updateRulePreview() {}
    QList<AutoCompleteTextEdit*> boxes() const {
        return {directIp, directDomain, directProcess, proxyIp, proxyDomain,
                proxyProcess, blockIp, blockDomain, blockProcess};
    }
    QStringList texts() const {
        QStringList result;
        for (auto *box : boxes()) result << box->toPlainText();
        return result;
    }
    void setTexts(const QStringList& values) {
        auto widgets = boxes();
        for (int i = 0; i < widgets.size(); ++i) widgets[i]->setPlainText(values[i]);
    }
    void go(int tab) { ui->tabWidget->setCurrentIndex(tab); QCoreApplication::processEvents(); }
    void clickSave() {
        ui->buttonBox->button(QDialogButtonBox::Ok)->click();
        QCoreApplication::processEvents();
    }
    void clickCancel() {
        ui->buttonBox->button(QDialogButtonBox::Cancel)->click();
        QCoreApplication::processEvents();
    }
    void editDirectRule(const QString& attr, const QString& value) {
        for (int i = 0; i < chain->Rules.size(); ++i) {
            auto rule = chain->Rules[i];
            if (rule->type == Configs::simpleAddress && rule->simpleAction == Configs::direct) {
                currentIndex = i;
                ui->rule_attr->setCurrentText(attr);
                ui->rule_attr_text->setPlainText(value);
                return;
            }
        }
        throw std::runtime_error("No simple direct rule in fixture");
    }
signals:
    void settingsChanged(std::shared_ptr<Configs::RoutingChain> routingChain);
};
@EDITOR_FUNCTIONS@

static const QStringList edits = {
    "ip:192.0.2.0/24\nip:2001:db8::/32", "domain:direct.example\nsuffix:direct.test",
    "processName:direct-app\nprocessPath:C:\\Apps\\direct.exe",
    "ip:198.51.100.0/24", "domain:proxy.example\nkeyword:proxy", "processName:proxy-app",
    "ip:203.0.113.0/24", "domain:block.example\nregex:.*block", "processPath:/opt/block-app"
};
static std::shared_ptr<Configs::RoutingChain> initial() {
    auto chain = std::make_shared<Configs::RoutingChain>();
    auto custom = std::make_shared<Configs::RouteRule>();
    custom->name = "dns-hijack";
    custom->type = Configs::custom;
    custom->simpleAction = Configs::direct;
    custom->protocol = "dns";
    custom->action = "hijack-dns";
    chain->Rules << custom;
    chain->UpdateSimpleRules("domain:original.example", Configs::direct);
    return chain;
}
static void require(bool result, const char *message) {
    if (!result) throw std::runtime_error(message);
}
static std::shared_ptr<Configs::RouteRule> directRule(const std::shared_ptr<Configs::RoutingChain>& chain) {
    for (auto rule : chain->Rules)
        if (rule->type == Configs::simpleAddress && rule->simpleAction == Configs::direct) return rule;
    throw std::runtime_error("Missing direct rule");
}
static void checkSaved(RouteItem& dialog, const QStringList& expected) {
    require(bool(dialog.saved), "Save did not emit settingsChanged");
    require(dialog.result() == QDialog::Accepted, "Save did not accept the real dialog");
    RouteItem reopened(dialog.saved);
    reopened.go(1);
    require(reopened.texts() == expected, "Saved/reopened Basic values differ");
}
int main(int argc, char **argv) {
    QApplication app(argc, argv);
    int failed = 0, total = 0;
    auto test = [&](const char *name, auto body) {
        ++total; warnings.clear();
        try { body(); std::cout << "PASS " << name << '\n'; }
        catch (const std::exception& error) { ++failed; std::cout << "FAIL " << name << ": " << error.what() << '\n'; }
    };
    for (int field = 0; field < edits.size(); ++field) {
        auto label = QString("isolated Basic field %1 survives Notes and Save").arg(field).toStdString();
        test(label.c_str(), [field] {
            RouteItem d(initial()); d.go(1);
            auto expected = d.texts(); expected[field] = edits[field];
            d.boxes()[field]->setPlainText(edits[field]); d.go(3); d.clickSave();
            checkSaved(d, expected);
        });
    }
    test("all nine fields survive Basic-General-Basic", [] {
        RouteItem d(initial()); d.go(1); d.setTexts(edits); d.go(0); d.go(1);
        require(d.texts() == edits, "General erased unsaved Basic text");
    });
    test("all nine fields survive Basic-Notes-Basic", [] {
        RouteItem d(initial()); d.go(1); d.setTexts(edits); d.go(3); d.go(1);
        require(d.texts() == edits, "Notes erased unsaved Basic text");
    });
    test("repeated tabs preserve text and notes", [] {
        RouteItem d(initial()); d.go(1); d.setTexts(edits); d.go(3);
        d.ui->notes->setPlainText("edited notes");
        for (int i = 0; i < 3; ++i) { d.go(0); d.go(1); d.go(3); }
        require(d.texts() == edits, "Repeated transitions erased Basic text");
        require(d.ui->notes->toPlainText() == "edited notes", "Repeated Notes entry erased notes");
    });
    for (int destination : {0, 1, 2, 3}) {
        auto name = QString("Basic edits save/reopen from tab %1").arg(destination).toStdString();
        test(name.c_str(), [destination] {
            RouteItem d(initial()); d.go(1); d.setTexts(edits); d.go(destination);
            d.clickSave(); checkSaved(d, edits);
        });
    }
    test("Basic-Advanced populates production rules", [] {
        RouteItem d(initial()); d.go(1); d.setTexts(edits); d.go(2);
        require(d.chain->GetSimpleRules(Configs::direct).contains("processPath:C:\\Apps\\direct.exe"), "Direct process path not committed");
        require(d.chain->GetSimpleRules(Configs::proxy).contains("domain:proxy.example"), "Proxy domain not committed");
        require(d.chain->GetSimpleRules(Configs::block).contains("ip:203.0.113.0/24"), "Block IP not committed");
        require(warnings.empty(), "Valid Basic text produced a warning");
    });
    for (const QList<int>& path : {QList<int>{}, QList<int>{1}, QList<int>{0, 2}, QList<int>{3, 1, 3}}) {
        QString label = "Advanced edits survive";
        for (int tab : path) label += "-" + QString::number(tab);
        label += "-Save";
        test(label.toStdString().c_str(), [path] {
            RouteItem d(initial()); d.go(2);
            d.editDirectRule("domain", "advanced.example");
            d.editDirectRule("port", "8443");
            for (int tab : path) d.go(tab);
            d.clickSave();
            require(bool(d.saved), "Advanced Save failed");
            auto rule = directRule(d.saved);
            require(rule->domain == QStringList{"advanced.example"}, "Stale Basic domain overwrote Advanced edit");
            require(rule->port == QStringList{"8443"}, "Unedited Basic boxes discarded Advanced-only port");
            RouteItem reopened(d.saved); reopened.go(1);
            require(reopened.directDomain->toPlainText() == "domain:advanced.example", "Advanced save/reopen lost domain");
        });
    }
    test("editing Basic after Advanced commits the newest Basic text", [] {
        RouteItem d(initial()); d.go(2); d.editDirectRule("domain", "advanced.example"); d.go(1);
        require(d.directDomain->toPlainText() == "domain:advanced.example", "Basic did not refresh from Advanced");
        d.directDomain->setPlainText("domain:newest.example"); d.go(0); d.go(2); d.clickSave();
        require(directRule(d.saved)->domain == QStringList{"newest.example"}, "Newer Basic edit was not saved");
    });
    test("successful Basic commit yields ownership to Advanced", [] {
        RouteItem d(initial()); d.go(1); d.setTexts(edits); d.go(2);
        d.editDirectRule("domain", "after-basic.example");
        d.editDirectRule("port", "9443"); d.clickSave();
        require(bool(d.saved), "Save after Basic-to-Advanced failed");
        require(directRule(d.saved)->domain == QStringList{"after-basic.example"}, "Successful commit retained a stale Basic draft");
        require(directRule(d.saved)->port == QStringList{"9443"}, "Basic commit replay erased Advanced-only port");
    });
    test("Cancel direct Advanced edits does not mutate shared input rules", [] {
        auto source = initial(); RouteItem d(source); d.go(2);
        d.editDirectRule("domain", "cancelled-direct.example");
        d.editDirectRule("port", "9999"); d.clickCancel();
        require(!d.saved, "Cancel emitted settingsChanged");
        require(directRule(source)->domain == QStringList{"original.example"}, "Cancel exposed a shallow rule copy");
        require(directRule(source)->port.isEmpty(), "Cancel leaked an Advanced-only field");
    });
    test("Cancel after tab commits leaves original chain untouched", [] {
        auto source = initial(); RouteItem d(source); d.go(1); d.setTexts(edits); d.go(2);
        d.editDirectRule("domain", "cancelled.example"); d.go(3); d.clickCancel();
        require(!d.saved, "Cancel emitted settingsChanged");
        require(d.result() == QDialog::Rejected, "Cancel did not reject the real dialog");
        require(source->GetSimpleRules(Configs::direct) == "domain:original.example\n", "Cancel mutated the original chain");
        require(source->Rules.size() == 2, "Cancel changed original rule count");
    });
    test("clear all Basic fields survives tabs and Save", [] {
        RouteItem d(initial()); d.go(1);
        for (auto box : d.boxes()) box->clear();
        d.go(0); d.go(3); d.clickSave();
        require(bool(d.saved), "Clear-all Save failed");
        require(d.saved->GetSimpleRules(Configs::direct).isEmpty(), "Tabs resurrected cleared rule");
        require(d.saved->Rules.size() == 1 && d.saved->Rules.first()->type == Configs::custom, "Custom rule changed");
    });
    test("invalid text survives navigation and rejected Save then can be corrected", [] {
        RouteItem d(initial()); d.go(1); d.directDomain->setPlainText("invalid-unprefixed-rule");
        d.go(0); d.go(3); d.go(2); d.go(1); d.clickSave();
        require(!d.saved, "Invalid Basic text was silently saved");
        require(!warnings.empty(), "Invalid text did not report validation error");
        require(d.directDomain->toPlainText() == "invalid-unprefixed-rule", "Navigation lost invalid text needed for correction");
        d.directDomain->setPlainText("domain:corrected.example"); d.clickSave();
        require(bool(d.saved), "Corrected Basic text could not save");
        require(directRule(d.saved)->domain == QStringList{"corrected.example"}, "Correction was not committed");
    });
    std::cout << "SUMMARY cases=" << total << " failures=" << failed << " Qt=" << qVersion() << '\n';
    return failed ? 1 : 0;
}
#include "regression.moc"
